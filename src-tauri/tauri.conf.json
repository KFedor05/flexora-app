{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flexora",
  "version": "1.0.9",
  "identifier": "com.flexora.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Flexora",
        "width": 1280,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": true,
        "alwaysOnTop": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Habit tracker with streaks",
    "longDescription": "Flexora is a cross-platform desktop habit tracker built around per-weekday templates, streaks, and a calendar view.",
    "publisher": "Flexora",
    "copyright": "© 2026 Flexora contributors",
    "homepage": "https://github.com/KFedor05/flexora-app",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
